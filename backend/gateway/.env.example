# ──────────────────────────────────────────────
# API Gateway environment variables
# Copy to backend/gateway/.env and fill in real values.
# ──────────────────────────────────────────────

# Port the gateway listens on.
PORT=3000

# Origin of the frontend (for CORS). Must match the Vite dev server URL.
FRONTENDS_URL=http://localhost:5173

# Internal URLs of the downstream microservices.
AUTH_SERVICE=http://localhost:3001
CHAT_SERVICE=http://localhost:3002
AGENT_SERVICE=http://localhost:3003

# Redis connection string. The bundled docker-compose maps host port 6380.
REDIS_URL=redis://localhost:6380
