# ──────────────────────────────────────────────
# Auth service environment variables
# Copy to backend/services/auth/.env and fill in real values.
# ──────────────────────────────────────────────

# Port the auth service listens on.
PORT=3001

# MongoDB connection string (Mongoose). Not included in docker-compose;
# provide a running instance, e.g. mongodb://localhost:27017/cortexai
MONGODB_URI=your_mongodb_connection_string_here

# Redis connection string. Used for session storage via shared/redis/redis.js.
# The bundled docker-compose maps host port 6380.
REDIS_URL=redis://localhost:6380

# ──────────────────────────────────────────────
# Firebase Admin SDK — supplied via a FILE, not env vars.
# Download the service-account JSON from Firebase Console →
#   Project Settings → Service accounts → Generate new private key,
# then place it at:
#   backend/services/auth/serviceAccountKey.json
# The file must contain: project_id, client_email, private_key.
# ──────────────────────────────────────────────
