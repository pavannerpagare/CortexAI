# ──────────────────────────────────────────────
# Chat service environment variables
# Copy to backend/services/chat/.env and fill in real values.
# ──────────────────────────────────────────────

# Port the chat service listens on.
PORT=3002

# MongoDB connection string (Mongoose). Stores conversations and messages.
MONGODB_URI=your_mongodb_connection_string_here

# ──────────────────────────────────────────────
# Firebase Admin SDK — supplied via a FILE, not env vars.
# config/firebase.js reads:
#   backend/services/chat/serviceAccountKey.json
# Download it from Firebase Console → Project Settings →
#   Service accounts → Generate new private key.
# The file must contain: project_id, client_email, private_key.
# NOTE: This file is currently not imported by the chat service's
#   runtime code (index.js / chat.controller.js), so it will only
#   be loaded if a module imports config/firebase.js. Keep the key
#   file present if you plan to use Firebase Admin in this service.
# ──────────────────────────────────────────────
