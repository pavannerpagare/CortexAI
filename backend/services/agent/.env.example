# ──────────────────────────────────────────────
# Agent service environment variables
# Copy to backend/services/agent/.env and fill in real values.
# ──────────────────────────────────────────────

# Port the agent service listens on.
PORT=3003

# MongoDB connection string (Mongoose). Stores RAG documents and chunks.
MONGODB_URI=your_mongodb_connection_string_here

# Redis connection string. Used for conversation memory caching
# via shared/redis/redis.js (config/memory.js).
REDIS_URL=redis://localhost:6380

# URL of the chat service — used to save and retrieve messages.
CHAT_SERVICE=http://localhost:3002

# Groq API key — powers the chat, search-router, and router LLM calls.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google (Gemini) API key — powers the coding agent and RAG embeddings.
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Tavily API key — powers the web-search agent.
# Get one at https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: override the Google embedding model (defaults to gemini-embedding-001).
# GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
