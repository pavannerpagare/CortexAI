# ──────────────────────────────────────────────
# Frontend (Vite) environment variables
# Copy to frontend/.env and fill in real values.
# All client-exposed vars MUST be prefixed with VITE_.
# ──────────────────────────────────────────────

# Base URL of the API gateway service.
# In local development this is the gateway's PORT (see backend/gateway/.env).
VITE_SERVER_URL=http://localhost:3000

# Firebase Web API key for the client SDK.
# Find it in Firebase Console → Project Settings → General → Web apps → API key.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
