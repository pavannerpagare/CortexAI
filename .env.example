# ──────────────────────────────────────────────
# Root .env.example — optional shared variables.
# This file is NOT loaded by any service automatically.
# Each service loads its own .env via dotenv; use the
# per-service .env.example files as the primary source.
# ──────────────────────────────────────────────

# If you prefer a single root .env for local development,
# you can symlink or copy values from the per-service files here.
# Otherwise, ignore this file and configure each service individually:
#
#   frontend/.env
#   backend/gateway/.env
#   backend/services/auth/.env
#   backend/services/chat/.env
#   backend/services/agent/.env
